<!-- arithmetic expresion -->

ARITHMETIC_EXP ::= ARITHMETIC_TERM
    | ARITHMETIC_TERM ADD ARITHMETIC_EXP
    | ARITHMETIC_TERM SUB ARITHMETIC_EXP

ARITHMETIC_TERM ::= ARITHMETIC_UNARY
    | ARITHMETIC_UNARY MUL ARITHMETIC_TERM
    | ARITHMETIC_UNARY DIV ARITHMETIC_TERM

ARITHMETIC_UNARY ::= ARITHMETIC_POWER
    | SUB ARITHMETIC_UNARY

ARITHMETIC_POWER ::= ARITHMETIC_ATOM
    | ARITHMETIC_ATOM POW ARITHMETIC_UNARY

ARITHMETIC_ATOM ::= NUMBER
    | LPAREN ARITHMETIC_EXP RPAREN

<!-- logic expresion -->

LOGIC_EXP ::= OR_EXP

OR_EXP ::= AND_EXP
    | AND_EXP OR OR_EXP

AND_EXP ::= NOT_EXP
    | NOT_EXP AND AND_EXP

NOT_EXP ::= LOGIC_TERM
    | NOT NOT_EXP

LOGIC_TERM ::= BOOLEAN
    | LPAREN LOGIC_EXP RPAREN

